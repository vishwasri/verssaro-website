# GitHub Container Registry settings (owner must be lowercase)
GHCR_OWNER=vishwasri
IMAGE_TAG=latest

# Public HTTP & HTTPS ports on the DigitalOcean Droplet
HTTP_PORT=80
HTTPS_PORT=443

# Primary production domain & contact email for SSL cert renewal
SSL_DOMAIN=verssaro.com
SSL_EMAIL=admin@verssaro.com

# MySQL 8 credentials (use alphanumeric / - / _ characters to keep DATABASE_URL valid)
MYSQL_DATABASE=verssaro_db
MYSQL_USER=verssaro
MYSQL_PASSWORD=CHANGE_ME_STRONG_MYSQL_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_ME_STRONG_ROOT_PASSWORD

# Backend application secrets & CORS
JWT_SECRET=CHANGE_ME_LONG_RANDOM_JWT_SECRET
# Comma-separated origins (e.g. https://verssaro.com,https://www.verssaro.com) or *
CORS_ORIGIN=*
