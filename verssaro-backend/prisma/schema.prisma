generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id             String         @id @default(cuid())
  email          String         @unique
  passwordHash   String
  name           String
  role           String         @default("CLIENT") // CLIENT | ADMIN
  dossierCode    String         @unique
  tier           String         @default("HERITAGE PATRON")
  vipActive      Boolean        @default(true)
  atelierHub     String         @default("COLOMBO")
  phone          String?
  liaisonName    String         @default("LAKSHAN P.")
  liaisonNotes   String         @default("Prefers oversized silhouettes, Sri Lankan heritage artwork, and bespoke gift boxing.") @db.VarChar(1000)
  totalSpendUsd  Float          @default(0)
  storeCreditUsd Float          @default(0)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  addresses      Address[]
  orders         Order[]
  wishlistItems  WishlistItem[]
  enquiries      Enquiry[]
}

model Address {
  id                   String   @id @default(cuid())
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label                String
  classification       String   @default("RESIDENTIAL") // RESIDENTIAL | OFFICE
  isDefault            Boolean  @default(false)
  recipientName        String
  company              String?
  addressLine1         String   @db.VarChar(500)
  addressLine2         String?  @db.VarChar(500)
  city                 String
  province             String?
  postalCode           String
  country              String
  countryCode          String   @default("LK")
  phone                String
  carrierPreference    String   @default("DHL Express Priority / Atelier Dispatch")
  deliveryInstructions String?  @db.Text
  packagingSpec        String   @default("BESPOKE_GIFT_BOX")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model Product {
  id               String         @id @default(cuid())
  slug             String         @unique
  sku              String         @unique
  seriesCode       String
  name             String
  subtitle         String
  category         String         // tees | editorial | capsules
  categoryLabel    String
  capsule          String
  editionLabel     String
  priceUsd         Float
  compareAtUsd     Float?
  cogsUsd          Float
  gsm              Int?
  material         String         @db.VarChar(500)
  silhouette       String         @default("oversized") // oversized | boxy | relaxed
  description      String         @db.Text
  fitNotes         String         @db.Text
  careNotes        String         @db.Text
  badge            String?
  status           String         @default("LIVE") // LIVE | UPCOMING | DRAFT | SOLD_OUT
  isFeatured       Boolean        @default(false)
  isBestseller     Boolean        @default(false)
  isNewDrop        Boolean        @default(false)
  ratingAvg        Float          @default(5.0)
  reviewCount      Int            @default(0)
  colorwaysJson    String         @db.Text // JSON: [{ name, hex, slug }]
  sizesJson        String         @db.Text // JSON: [{ size, stock, colombo }]
  imagesJson       String         @db.LongText // JSON: string[]
  measurementsJson String         @db.Text // JSON: [{ size, chest, length, shoulder, sleeve }]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  reviews          Review[]
  cartItems        CartItem[]
  wishlistItems    WishlistItem[]
  orderItems       OrderItem[]
  enquiryItems     EnquiryItem[]
}

model Review {
  id             String   @id @default(cuid())
  productId      String
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  authorName     String
  authorLocation String   @default("Colombo / Verified Client")
  verifiedBuyer  Boolean  @default(true)
  rating         Int
  fitFeedback    String   @default("oversized") // runs_small | true_to_size | oversized
  title          String
  body           String   @db.Text
  sizePurchased  String   @default("L")
  colorPurchased String   @default("Black")
  helpfulCount   Int      @default(0)
  createdAt      DateTime @default(now())
}

model CartItem {
  id        String   @id @default(cuid())
  sessionId String
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  size      String
  colorName String
  colorHex  String   @default("#000000")
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sessionId, productId, size, colorName])
}

model CartSession {
  sessionId     String   @id
  promoCode     String?
  collectorBox  Boolean  @default(true)
  giftMessage   String?  @db.Text
  reservedUntil DateTime
  updatedAt     DateTime @updatedAt
}

model WishlistItem {
  id            String   @id @default(cuid())
  sessionId     String
  userId        String?
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  productId     String
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  selectedSize  String   @default("L")
  selectedColor String   @default("Black")
  stockState    String   @default("IN_STOCK") // IN_STOCK | LOW_STOCK | PRE_ORDER
  createdAt     DateTime @default(now())

  @@unique([sessionId, productId])
}

model PromoCode {
  id               String   @id @default(cuid())
  code             String   @unique
  name             String
  description      String   @db.Text
  campaignType     String   @default("HERITAGE_PROMO")
  discountType     String   @default("PERCENT") // PERCENT | FIXED
  discountValue    Float
  minSubtotalUsd   Float    @default(0)
  gateTarget       String   @default("Open Registry")
  marginCapPercent Float    @default(18)
  claimsUsed       Int      @default(0)
  claimsLimit      Int      @default(500)
  attributedRevUsd Float    @default(0)
  status           String   @default("LIVE") // LIVE | SCHEDULED | ARCHIVED
  endsAt           DateTime
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Order {
  id                    String      @id @default(cuid())
  orderNumber           String      @unique
  userId                String?
  user                  User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  sessionId             String
  customerName          String
  email                 String
  phone                 String?
  status                String      @default("UNFULFILLED") // UNFULFILLED | PROCESSING_QC | DISPATCHED | DELIVERED | HOLD
  paymentMethod         String      @default("card")
  paymentStatus         String      @default("SETTLED")
  shippingMethod        String      @default("colombo_same_day")
  carrierName           String      @default("DHL Express Priority / Atelier Dispatch")
  trackingNumber        String
  destinationCode       String      @default("CMB-01")
  shippingAddressJson   String      @db.Text
  packagingManifestJson String      @db.Text
  subtotalUsd           Float
  discountUsd           Float       @default(0)
  shippingUsd           Float       @default(0)
  dutyUsd               Float       @default(0)
  totalUsd              Float
  promoCodeUsed         String?
  milestoneStep         Int         @default(2)
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  items                 OrderItem[]
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  sku       String
  name      String
  size      String
  colorName String
  imageUrl  String  @db.Text
  unitPrice Float
  quantity  Int
  lineTotal Float
}

model Enquiry {
  id           String        @id @default(cuid())
  enquiryCode  String        @unique
  userId       String?
  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  customerName String
  email        String?
  phone        String?
  notes        String?       @db.Text
  source       String        @default("WEBSITE_DRAWER") // WEBSITE_DRAWER | WHATSAPP | INSTAGRAM | EMAIL
  status       String        @default("NEW") // NEW | IN_PROGRESS | CONFIRMED | FULFILLED | ARCHIVED
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  items        EnquiryItem[]
}

model EnquiryItem {
  id        String   @id @default(cuid())
  enquiryId String
  enquiry   Enquiry  @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  name      String
  size      String
  colorName String   @default("Black")
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  source    String   @default("FOOTER_INNER_CIRCLE")
  createdAt DateTime @default(now())
}
